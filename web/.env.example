# Copy this to .env and fill in real values. .env is gitignored.

DATABASE_URL="file:./dev.db"

# OpenAI — get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Defaults; override if you have access to different model snapshots.
OPENAI_MODEL_TEXT=gpt-5.4
OPENAI_MODEL_IMAGE=gpt-image-2-2026-04-21

# Provider switch: "openai" uses the real API; "stub" runs fully offline with heuristics.
AI_PROVIDER=openai

# Where the Python PSD-parsing worker runs (started by start.command).
PSD_WORKER_URL=http://127.0.0.1:8787
