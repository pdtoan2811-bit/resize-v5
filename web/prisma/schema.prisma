generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Psd {
  id              String   @id @default(cuid())
  hash            String   @unique
  filename        String
  width           Int
  height          Int
  createdAt       DateTime @default(now())
  iterationNotes  String?  // Level 2: accumulated learnings for this PSD
  // Which engine produces the source HTML used by previews and AI Rewrite:
  //   "algorithm" — deterministic emit (cheap, exact reproduction)
  //   "ai"        — AI-authored HTML/CSS conditioned on brand context
  sourceEngine    String   @default("algorithm")
  sourceAiReason  String?  // one-line reasoning the AI gave for its source design

  layers      Layer[]
  groups      Group[]
  renders     Render[]
  imagineRefs ImagineRef[]
}

// Level 3: organization-wide context. Singleton row (id = "default").
//
// Split into "brand identity" (applies everywhere) and four stage-specific
// blocks. Each stage block is injected ONLY into prompts for that stage,
// keeping per-stage prompts tight without ballooning every AI call.
model Organization {
  id        String   @id @default("default")

  // Brand identity — always-on, prepended to every AI prompt
  brandName String?
  voice     String?
  audience  String?
  doRules   String?
  dontRules String?
  freeform  String?

  // Stage-specific context blocks
  groupingContext     String?  // semantic grouping pass only
  sourceEngineContext String?  // AI source HTML/CSS engine only
  resizeContext       String?  // AI Responsive + AI Rewrite resize calls
  verifyContext       String?  // vision critique only

  updatedAt DateTime @updatedAt
}

model Layer {
  id      String @id @default(cuid())
  psdId   String
  lid     String
  name    String
  x       Int
  y       Int
  w       Int
  h       Int
  z       Int
  opacity Float  @default(1)
  bm      String @default("normal")
  pngPath String
  kind    String

  psd Psd @relation(fields: [psdId], references: [id], onDelete: Cascade)

  @@unique([psdId, lid])
}

model Group {
  id         String  @id @default(cuid())
  psdId      String
  gid        String
  role       String
  label      String
  importance String
  layerIds   String
  anchorHint String?
  rationale  String?
  userEdited Boolean @default(false)

  psd Psd @relation(fields: [psdId], references: [id], onDelete: Cascade)

  @@unique([psdId, gid])
}

model Render {
  id         String   @id @default(cuid())
  psdId      String
  mode       String   @default("responsive") // responsive | rewrite
  targetW    Int
  targetH    Int
  presetName String?
  layoutJson String
  htmlPath   String?
  pngPath    String?
  status     String   @default("pending")
  score      Float?
  rubricJson String?
  reasoning  String?
  attempts   Int      @default(0)
  costUsd    Float    @default(0)
  latencyMs  Int?
  createdAt  DateTime @default(now())

  psd Psd @relation(fields: [psdId], references: [id], onDelete: Cascade)

  @@unique([psdId, mode, targetW, targetH])
}

model ImagineRef {
  id      String @id @default(cuid())
  psdId   String
  targetW Int
  targetH Int
  prompt  String
  pngPath String

  psd Psd @relation(fields: [psdId], references: [id], onDelete: Cascade)

  @@unique([psdId, targetW, targetH])
}
